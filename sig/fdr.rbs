module Fdr
  VERSION: String

  module Error
  end

  class InvalidPattern < ::RegexpError
    include Error
  end

  class InvalidOption < ::ArgumentError
    include Error
  end

  class InvalidType < ::TypeError
    include Error
  end

  class OutOfRange < ::RangeError
    include Error
  end

  class IOError < ::IOError
    include Error
  end

  type file_type = "f" | "file" | :f | :file
                 | "d" | "dir" | "directory" | :d | :dir | :directory
                 | "l" | "symlink" | :l | :symlink

  def self.search: (
    ?pattern: ::string?,
    ?paths: ::array[::path],
    ?hidden: ::boolish,
    ?no_ignore: ::boolish,
    ?case_sensitive: ::boolish,
    ?glob: ::boolish,
    ?full_path: ::boolish,
    ?follow: ::boolish,
    ?max_depth: Integer?,
    ?min_depth: Integer?,
    ?type: (file_type | ::array[file_type])?,
    ?extension: (::string | ::array[::string])?,
    ?exclude: ::array[::string]?,
    ?min_size: Integer?,
    ?max_size: Integer?,
    ?changed_within: Integer?,
    ?changed_before: Integer?,
    ?ignore_error: ::boolish,
    ?ignore_file: ::array[::path]
  ) -> Array[String]

  def self.grep: (
    pattern: ::string,
    ?name: ::string?,
    ?paths: ::array[::path],
    ?hidden: ::boolish,
    ?no_ignore: ::boolish,
    ?case_sensitive: ::boolish,
    ?content_case_sensitive: ::boolish,
    ?glob: ::boolish,
    ?full_path: ::boolish,
    ?follow: ::boolish,
    ?max_depth: Integer?,
    ?min_depth: Integer?,
    ?extension: (::string | ::array[::string])?,
    ?exclude: ::array[::string]?,
    ?min_size: Integer?,
    ?max_size: Integer?,
    ?changed_within: Integer?,
    ?changed_before: Integer?,
    ?ignore_error: ::boolish,
    ?ignore_file: ::array[::path]
  ) -> Hash[String, Hash[Integer, String]]
end
